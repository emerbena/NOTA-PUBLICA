{
  "name": "nota-publica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "check": "node scripts/check-source.mjs",
    "test": "node --test test/*.test.js",
    "db:check": "node scripts/check-database.mjs",
    "db:check:neon": "tsx scripts/check-neon.ts",
    "release:check": "node scripts/check-production.mjs",
    "release:initialize": "tsx scripts/initialize-production.ts",
    "admin:create:production": "tsx scripts/bootstrap-production-admin.ts",
    "check:neon:web": "tsx scripts/check-neon-web.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "env:check": "tsx scripts/check-platform-env.ts",
    "env:check:legacy": "node scripts/check-env.mjs",
    "test:e2e": "playwright test --config playwright.platform.config.ts",
    "test:e2e:legacy": "playwright test --config playwright.config.js",
    "verify": "npm run check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:integration",
    "dev:legacy": "node server.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "admin:create": "tsx scripts/bootstrap-admin.ts",
    "test:admin": "tsx --test test/bootstrap-admin.test.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:neon": "tsx --test test/neon/*.test.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@electric-sql/pglite": "0.5.16",
    "@neondatabase/serverless": "^1.2.1",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-youtube": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@vercel/blob": "2.4.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
