# El camino local recomendado es npm run setup:local; genera secretos sin imprimirlos.
# No sobrescribas un .env.local existente. Todas estas variables son privadas.
NP_ENV=development
NP_DATABASE_MODE=local
NP_LOCAL_DATABASE=.local-db/main
CONTENT_MODE=demo
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
CRON_SECRET=

# Neon DESARROLLO: NP_DATABASE_MODE=neon, URL de rama aislada, nunca producción.
# Formato: postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# IDs no secretos obtenidos de Neon y verificados contra development.
NP_EXPECTED_NEON_BRANCH_ID=
NP_EXPECTED_NEON_ENDPOINT_ID=
# Archivos locales solo durante desarrollo; blob requiere BLOB_READ_WRITE_TOKEN.
NP_MEDIA_STORAGE=local
# Solo después de comprobar que DATABASE_URL apunta a la rama autorizada:
NP_ALLOW_DEV_MIGRATION=no

# Almacenamiento de objetos para Vercel; no se necesita con NP_DATABASE_MODE=local.
BLOB_READ_WRITE_TOKEN=

# NP_ENV, NP_DATABASE_MODE y CONTENT_MODE son conceptos diferentes:
# modo local = PostgreSQL PGlite para desarrollo; neon = conexión PostgreSQL remota.
# CONTENT_MODE=live muestra exclusivamente contenido real; demo solo los ejemplos.
# No usar PGlite en Vercel ni subir .env.local. No añadir prefijos NEXT_PUBLIC_ a secretos.
# No fijar NODE_ENV manualmente: Next lo selecciona con dev/build/start.
